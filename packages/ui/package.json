{
  "name": "@mono/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.mts",
        "default": "./dist/tokens.mjs"
      },
      "require": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@mono/eslint-config": "workspace:*",
    "@mono/tsconfig": "workspace:*",
    "eslint": "^10.0.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "@types/react": "^19.2.0",
    "react": "^19.2.0"
  }
}
